# StockMaster — Environment Variables
# Copy this to .env for local dev, or set via Elastic Beanstalk environment

# AWS
AWS_REGION=us-west-2

# Database (RDS PostgreSQL)
DB_HOST=stockmaster-db.xxxxxxxxxxxx.us-west-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=stockmaster_prod
DB_USER=stockmaster_admin
DB_PASSWORD=your-password-from-secrets-manager

# SNS
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:ACCOUNT_ID:stockmaster-alerts-topic

# SQS
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/ACCOUNT_ID/stockmaster-inventory-queue

# S3 Buckets
S3_BACKUP_BUCKET=stockmaster-backup-STUDENTID
S3_STATIC_BUCKET=stockmaster-static-STUDENTID

# DynamoDB
DYNAMO_TABLE=stockmaster-audit-log

# EFS (mounted path inside EC2)
EFS_UPLOAD_PATH=/mnt/efs/uploads

# Node
NODE_ENV=production
PORT=3000
